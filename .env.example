# Copy file này thành .env khi chạy ở máy local.
# .env đã nằm trong .gitignore nên KHÔNG BAO GIỜ bị đẩy lên GitHub.
# Trên GitHub / Render thì không dùng file này — khai báo trong Secrets.

TELEGRAM_TOKEN=dan_token_moi_cua_botfather_vao_day
TELEGRAM_CHAT_ID=5794043991

# Sàn lấy dữ liệu. Đổi sang kucoin / okx / bybit / gateio nếu Binance báo lỗi 451
EXCHANGE_ID=binance

# Đặt =1 để dùng mirror data-api.binance.vision (thử khi Binance chặn IP)
BINANCE_DATA_MIRROR=0

# =1: quét đúng 1 lần rồi thoát (dùng cho GitHub Actions)
# =0: chạy vòng lặp liên tục (dùng cho Render / VPS / máy nhà)
RUN_ONCE=0

# =1: bật Flask API /signals cho app Android (chỉ có tác dụng khi RUN_ONCE=0)
ENABLE_API=1

# Proxy (tùy chọn) nếu cần vượt chặn địa lý
# HTTPS_PROXY=http://user:pass@ip:port
